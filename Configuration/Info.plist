<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>UIAppFonts</key>
    <array>
        <string>Fraunces-Regular.ttf</string>
        <string>Fraunces-Bold.ttf</string>
        <string>PlusJakartaSans.ttf</string>
    </array>
    <key>EiraServerURL</key>
    <string>$(EIRA_SERVER_URL)</string>
    <key>EiraAppToken</key>
    <string>$(EIRA_APP_TOKEN)</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Mikrofon dipakai saat kamu memilih merekam suara untuk diubah menjadi teks. Berkas suara dihapus setelahnya.</string>
    <key>EiraReportTarget</key>
    <string>$(EIRA_REPORT_TARGET)</string>
</dict>
</plist>
